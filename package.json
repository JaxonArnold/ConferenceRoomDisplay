{
  "name": "cwaapp",
  "version": "1.0.0",
  "description": "Conference room welcome display for Daylite CRM appointments",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test-token": "node test-token-refresh.js",
    "setup": "node setup.js",
    "install-service": "node service.js install",
    "uninstall-service": "node service.js uninstall",
    "restart": "node service.js restart",
    "status": "node service.js status",
    "logs": "tail -n 50 -f logs/server.log"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
